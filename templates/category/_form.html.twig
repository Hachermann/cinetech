{{ form_start(form, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}
    {% for field in form %}
        {% if 'hidden' in field.vars.block_prefixes %}
            {{ form_widget(field) }}
        {% else %}
            <div class="flex flex-col gap-2">
                {{ form_label(field, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-300'}}) }}
                {{ form_widget(field, {'attr': {'class': 'w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-2 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/40'}}) }}
                <div class="text-sm text-red-400">{{ form_errors(field) }}</div>
            </div>
        {% endif %}
    {% endfor %}

    <button type="submit" class="rounded-lg bg-amber-400 px-5 py-2 font-semibold text-slate-900 transition hover:bg-amber-500">
        {{ button_label|default('Enregistrer') }}
    </button>
{{ form_end(form) }}
