{% extends 'base.html.twig' %}

{% block title %}Catalogue - CinéCatalogue{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-900 text-slate-200">
    

    <main class="mx-auto max-w-6xl px-6 py-10">
        <h1 class="mb-2 text-3xl font-bold text-slate-50">Catalogue</h1>
        <p class="mb-8 text-slate-400">
            {{ movies|length }} film{{ movies|length > 1 ? 's' : '' }} disponible{{ movies|length > 1 ? 's' : '' }}
        </p>

        {% if tag is defined and tag != 'general' %}
            <p class="mb-8 text-slate-400">Recherche : {{ tag|upper }}</p>
        {% endif %}

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for movie in movies %}
                <article class="flex flex-col gap-2 rounded-xl border border-slate-700 bg-slate-800 p-5 transition hover:-translate-y-1 hover:border-amber-400">
                    <span class="text-xs font-semibold tracking-wider text-amber-400">{{ movie.category.name|upper }}</span>
                    
                    <h2 class="text-xl font-bold text-slate-50">{{ movie.title }}</h2>
                    <p class="text-sm text-slate-400">Sortie : {{ movie.dateSortie ? movie.dateSortie|date('d/m/Y') : '' }}</p>
                    <p class="text-sm leading-relaxed text-slate-400">
                        {{ movie.synopsis|slice(0, 100) }}{% if movie.synopsis|length > 120 %}…{% endif %}
                    </p>
                   

                    {% if movie.NotePresse >= 4.5 %}
                        <span class="self-start rounded-full bg-amber-400 px-3 py-1 text-sm font-bold text-slate-900">⭐ Coup de cœur</span>
                    {% endif %}

                    <a href="{{ path('app_movie_show', {id: movie.id}) }}"
                       class="mt-auto rounded-lg bg-amber-400 px-4 py-2 text-center font-semibold text-slate-900 hover:bg-amber-500">
                        Voir les détails
                    </a>
                    <a href="{{ path('app_movie_edit', {id: movie.id}) }}"
                       class="mt-auto rounded-lg bg-amber-400 px-4 py-2 text-center font-semibold text-slate-900 hover:bg-amber-500">
                        Modifier le film
                    </a>
                    
                </article>
            {% else %}
                <p class="text-slate-400">Aucun film à afficher.</p>
            {% endfor %}
        </div>
    </main>

    <footer class="border-t border-slate-800 py-8 text-center text-sm text-slate-500">
        © {{ "now"|date("Y") }} CinéCatalogue
    </footer>
</div>
{% endblock %}
   