<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ movie.title }}</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; max-width: 720px; }
        .badge { background: #ffc107; padding: .2rem .6rem; border-radius: 999px; font-weight: bold; }
    </style>
</head>
<body>
    <a href="{{ path('app_movie_index') }}">← Retour au catalogue</a>

    <h1>{{ movie.title }}</h1>
    <p>{{ movie.category.name|upper }} · {{ movie.dateSortie ? movie.dateSortie|date('d/m/Y') : '' }}</p>
    <p>{{ movie.synopsis }}</p>
    <p>Note : {{ movie.NotePresse is empty ? 'Non noté' : movie.NotePresse }}</p>

    {% if movie.NotePresse >= 4.5 %}
        <span class="badge">⭐ Coup de cœur</span>
    {% endif %}
</body>
</html>