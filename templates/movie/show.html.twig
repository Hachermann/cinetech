{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }} - CinéCatalogue{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-900 px-6 py-10 text-slate-200">
    <div class="mx-auto max-w-3xl">
        <a href="{{ path('app_movie_index') }}" class="text-sm text-amber-400 hover:text-amber-300">← Retour au catalogue</a>

        <article class="mt-6 rounded-xl border border-slate-700 bg-slate-800 p-8">
            <div class="flex flex-wrap items-center gap-3">
                {% if movie.category %}
                    <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">{{ movie.category.name|upper }}</span>
                {% endif %}
                {% if movie.NotePresse >= 4.5 %}
                    <span class="rounded-full bg-amber-400 px-3 py-1 text-sm font-bold text-slate-900">⭐ Coup de cœur</span>
                {% endif %}
            </div>

            <h1 class="mt-3 text-4xl font-bold text-slate-50">{{ movie.title }}</h1>

            <dl class="mt-6 grid grid-cols-2 gap-4">
                <div class="rounded-lg border border-slate-700 bg-slate-900 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Date de sortie</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-50">
                        {{ movie.dateSortie ? movie.dateSortie|date('d/m/Y') : 'Non renseignée' }}
                    </dd>
                </div>
                <div class="rounded-lg border border-slate-700 bg-slate-900 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Note presse</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-50">
                        {{ movie.NotePresse is empty ? 'Non noté' : movie.NotePresse ~ ' / 5' }}
                    </dd>
                </div>
            </dl>

            <section class="mt-8">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Synopsis</h2>
                <p class="mt-3 leading-relaxed text-slate-300">
                    {{ movie.synopsis ?: 'Aucun synopsis pour le moment.' }}
                </p>
            </section>

            <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-slate-700 pt-6">
                <a href="{{ path('app_movie_edit', {id: movie.id}) }}"
                   class="rounded-lg bg-amber-400 px-5 py-2 font-semibold text-slate-900 transition hover:bg-amber-500">
                    Modifier
                </a>

                <form method="post"
                      action="{{ path('app_movie_delete', {id: movie.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement ce film ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ movie.id) }}">
                    <button type="submit"
                            class="rounded-lg border border-red-500 px-5 py-2 font-semibold text-red-400 transition hover:bg-red-500 hover:text-white">
                        Supprimer
                    </button>
                </form>
            </div>
        </article>
    </div>
</div>
{% endblock %}
